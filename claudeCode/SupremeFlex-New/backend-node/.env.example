NODE_ENV=development
PORT=8001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=supremeflex
DB_USER=supremeflex_app
DB_PASSWORD=
JWT_SECRET=
PHP_BASE_URL=http://localhost:8000
PHP_INTERNAL_KEY=

# Redis (shared with PHP; same instance, same db)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Dev-only flags — all MUST be absent or false in production
OTP_DEV_PEEK=false
GPSHOP_MOCK=true
LOCATION_CHANGE_API_MOCK=true
REAL_IP_API_MOCK=true
CUSTOMER_LIFECYCLE_MOCK=true
